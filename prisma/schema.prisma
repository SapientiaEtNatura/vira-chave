generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ESTUDANTE
  EDUCADOR
  ADMIN
}

enum ProgressStatus {
  NAO_INICIADO
  EM_ANDAMENTO
  CONCLUIDO
}

enum ConsentType {
  TERMOS_USO
  PRIVACIDADE
  SIGILO_EDUCADOR
  VINCULO_ESCOLAR
  EXCLUSAO_CONTA
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role     @default(ESTUDANTE)
  institutionId String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution         Institution?          @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  consents            ConsentRecord[]
  taughtClassrooms    Classroom[]           @relation("EducatorClassrooms")
  enrollments         ClassroomEnrollment[]
  discoveryResults    DiscoveryResult[]
  courseProgress      CourseProgress[]
  portfolioProjects   PortfolioProject[]
  shareLinks          PortfolioShareLink[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]            @relation("AuditActor")

  @@index([createdAt])
  @@index([role, createdAt])
}

model ConsentRecord {
  id            String      @id @default(cuid())
  userId        String?
  anonymizedRef String?
  type          ConsentType
  version       String
  acceptedAt    DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([anonymizedRef])
}

model Institution {
  id              String   @id @default(cuid())
  name            String
  institutionCode String   @unique
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  users      User[]
  classrooms Classroom[]
}

model Classroom {
  id            String   @id @default(cuid())
  institutionId String
  educatorId    String
  name          String
  inviteCode    String   @unique
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  institution Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  educator    User                  @relation("EducatorClassrooms", fields: [educatorId], references: [id], onDelete: Cascade)
  enrollments ClassroomEnrollment[]

  @@index([institutionId])
  @@index([educatorId])
}

model ClassroomEnrollment {
  id          String   @id @default(cuid())
  classroomId String
  studentId   String
  enrolledAt  DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classroomId, studentId])
  @@index([studentId])
}

model MacroArea {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String

  tracks     Track[]
  challenges Challenge[]
}

model DiscoveryQuestion {
  id            String @id @default(cuid())
  prompt        String
  order         Int    @unique
  weightsByArea Json
}

model DiscoveryResult {
  id          String   @id @default(cuid())
  studentId   String
  scoresJson  Json
  topAreas    String[]
  completedAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Track {
  id          String  @id @default(cuid())
  macroAreaId String
  title       String
  description String
  published   Boolean @default(true)

  macroArea MacroArea    @relation(fields: [macroAreaId], references: [id], onDelete: Cascade)
  courses   CourseItem[]

  @@index([macroAreaId])
}

model CourseItem {
  id              String    @id @default(cuid())
  trackId         String
  title           String
  providerName    String
  externalUrl     String
  order           Int
  lastCheckedAt   DateTime?
  lastCheckOk     Boolean?
  lastCheckStatus Int?

  track    Track            @relation(fields: [trackId], references: [id], onDelete: Cascade)
  progress CourseProgress[]

  @@unique([trackId, order])
}

model CourseProgress {
  id                String         @id @default(cuid())
  studentId         String
  courseItemId      String
  status            ProgressStatus @default(NAO_INICIADO)
  notes             String?
  certificateFileId String?
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime       @updatedAt

  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseItem CourseItem @relation(fields: [courseItemId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseItemId])
  @@index([studentId])
}

model Challenge {
  id          String  @id @default(cuid())
  macroAreaId String
  title       String
  description String
  published   Boolean @default(true)

  macroArea MacroArea          @relation(fields: [macroAreaId], references: [id], onDelete: Cascade)
  projects  PortfolioProject[]

  @@index([macroAreaId])
}

model PortfolioProject {
  id                String   @id @default(cuid())
  studentId         String
  challengeId       String?
  title             String
  summary           String
  reflection        String
  externalUrl       String?
  isIncludedInShare Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  student       User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  challenge     Challenge?     @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  evidenceFiles EvidenceFile[]

  @@index([studentId])
}

model EvidenceFile {
  id           String   @id @default(cuid())
  projectId    String
  storageKey   String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  project PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model PortfolioShareLink {
  id        String    @id @default(cuid())
  studentId String
  tokenHash String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
